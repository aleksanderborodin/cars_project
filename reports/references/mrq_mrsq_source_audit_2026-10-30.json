  "source_findings": [
    {
      "id": "partitions",
      "finding": "Both upstream Gym wrappers construct a generic Gym environment; they do not enforce our train/development namespace. A repository-owned restricted environment harness is required."
    },
    {
      "id": "action_mapping",
      "finding": "Continuous agents output symmetric normalized actions times one scalar max_action; use a bijective outer affine mapping for CarRacing gas/brake and store the normalized action in replay."
    },
    {
      "id": "history",
      "finding": "Gym wrappers declare history=1. Neither algorithm supplies a recurrent local encoder; bounded history versus recurrent PPO must be disclosed and controlled."
    },
    {
      "id": "mrq_gpu_storage_estimate",
      "finding": "In MRQ buffer.py the conditional expression obs_space=product*1 if pixel_obs else 4 yields scalar 4 in the nonpixel branch. Require explicit corrected storage budgeting before allocation."
    },
    {
      "id": "mrsq_cpu_cuda_query",
      "finding": "MRSQ buffer.py check_memory calls torch.cuda.mem_get_info unconditionally, including CPU configurations; isolate/correct the storage helper and test CPU behavior before use."
    },
    {
      "id": "mrsq_pixel_path",
      "finding": "MRSQ Encoder initializes ln_zsa only in the nonpixel branch but model_all accesses it in both branches; pixel planning/training path requires a synthetic execution check and explicitly recorded resolution."
    },
    {
      "id": "spatial_shape",
      "finding": "Both upstream pixel CNNs hard-code a 1568-dimensional flattened input. The 61x61 local grid produces 512 dimensions; 84x84 produces 1568. No direct drop-in local pixel adapter is established."
    },
    {
      "id": "stochastic_evaluation",
      "finding": "MRSQ evaluation invokes planning with Gaussian proposals and Gumbel elite selection. Disabling exploration noise does not make the planner deterministic; isolate/reset/checkpoint planning RNG and warm starts."
    },
    {
      "id": "effective_q_horizon",
      "finding": "MRSQ declares q_horizon=3 but train() samples enc_horizon=5 for its RL target. Preserve actual pinned behavior in the primary adaptation or label a correction separately."
    },
    {
      "id": "validation_rng",
      "finding": "Upstream evaluation uses global Torch/NumPy RNG state. Preserve/restore learner RNG around development evaluation and use separate planning streams."
    },
    {
      "id": "replay_boundary",
      "finding": "Terminal/timeout paths are nontrivial and buffers store final observations in additional slots. Native frame and decision counters must not use replay size; synthetic terminal, truncation, history and ring-wrap parity checks precede training."
    },
    {
      "id": "training_compute",
      "finding": "MRQ/MRSQ train() performs bursts of 250 encoder updates at target synchronization, plus per-call RL updates. Profile the first warm-up crossing and complete later burst; model runtime cannot be inferred from PPO."
    }
  ],
